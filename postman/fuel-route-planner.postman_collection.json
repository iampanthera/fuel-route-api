      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"422\", () => pm.response.to.have.status(422));",
              "pm.test(\"code INFEASIBLE_ROUTE\", () => pm.expect(pm.response.json().error.code).to.eql(\"INFEASIBLE_ROUTE\"));"
            ]
          }
        }
      ]
    },
