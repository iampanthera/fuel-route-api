{
  "info": {
    "name": "Fuel Route Planner API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Demo requests for the fuel route planner. Run the server, then Send in order. Request 2 stores the map URL used by request 11."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "mapUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Short trip, no stop needed (Chicago to Indianapolis)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/route-plan/",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Indianapolis, IN\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"one routing call (or cache hit)\", () => pm.expect(b.meta.routing_api_calls).to.be.at.most(1));",
              "pm.test(\"no leg over 500 mi\", () => { const m=[0,...b.fuel_stops.map(s=>s.route_mile), b.route.distance_miles]; for (let i=1;i<m.length;i++) pm.expect(m[i]-m[i-1]).to.be.at.most(500.5); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Long trip (Chicago to Dallas)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/route-plan/",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Dallas, TX\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"one routing call (or cache hit)\", () => pm.expect(b.meta.routing_api_calls).to.be.at.most(1));",
              "pm.test(\"no leg over 500 mi\", () => { const m=[0,...b.fuel_stops.map(s=>s.route_mile), b.route.distance_miles]; for (let i=1;i<m.length;i++) pm.expect(m[i]-m[i-1]).to.be.at.most(500.5); });",
              "pm.collectionVariables.set(\"mapUrl\", b.map_url);"
            ]
          }
        }
      ]
    },
